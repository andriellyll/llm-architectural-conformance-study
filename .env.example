# Mistral AI API key (required for all pipeline steps)
# Obtain at: https://console.mistral.ai/
MISTRAL_API_KEY=

# GitHub personal access token (required for Step 1b: filter_by_comment_year.py)
# Requires no special scopes; a classic token with public access is sufficient.
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=

# PostgreSQL / pgvector connection settings (required for Steps 3-4)
# Default values match the docker-compose.yml configuration.
# Only change these if you are using a custom database setup.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=archunit_docs
